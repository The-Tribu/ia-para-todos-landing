---
// Sección 06 — Qué incluye
// Lista vertical con ícono + título + detalle.
// Los diferenciadores (Certificado, Claude Pro y Proyecto final) cierran la misma lista
// y se distinguen solo por el color del ícono y de la tipografía.
import { COHORTE } from "../lib/cohorte";
import IncludesRow, { type Item } from "./IncludesRow.astro";

const items: Item[] = [
  {
    title: "Formación práctica",
    detail: `${COHORTE.duracion} · ${COHORTE.sesiones} sábados · ${COHORTE.horario}`,
    icon: "calendar",
  },
  {
    title: "Comunidad",
    detail: "Grupo privado de WhatsApp con acceso directo al instructor",
    icon: "users",
  },
  {
    title: "Recursos",
    detail: "Materiales y recursos de por vida",
    icon: "download",
  },
  {
    title: "Certificado",
    detail: "Certificado virtual — <i>Inteligencia Artificial Aplicada al Trabajo Profesional</i>",
    icon: "award",
    featured: true,
    eyebrow: "apto para LinkedIn",
  },
  {
    title: "Claude Pro",
    detail: "Acceso durante todo el programa (~$86.000 COP de valor)",
    icon: "key-round",
    featured: true,
    eyebrow: "incluido sin costo",
  },
  {
    title: "Proyecto final",
    detail: "Personalizado a la profesión del estudiante",
    icon: "wrench",
    featured: true,
    eyebrow: "el diferenciador",
  },
];
---

<section
  data-screen-label="06 Qué incluye"
  style="padding: clamp(56px, 9vw, 104px) 0; background: var(--bg-1); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);"
>
  <div
    style="max-width: 1080px; margin: 0 auto; padding: 0 20px; display: flex; flex-direction: column; gap: clamp(28px, 4vw, 44px);"
  >
    <h2
      style="font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 4.6vw, 40px); line-height: 1.15; letter-spacing: -0.02em; margin: 0;"
    >
      Qué incluye
    </h2>
    <div class="includes-list">
      {items.map((item) => <IncludesRow {...item} />)}
    </div>
  </div>
</section>

<style>
  .includes-list {
    display: flex;
    flex-direction: column;
    max-width: 780px;
    border-top: 1px solid var(--border-default);
  }
</style>
