---
// Sección 06 — Qué incluye
// Lista vertical con ícono + título + detalle.
// Los dos diferenciadores (Claude Pro + Proyecto final) cierran la sección
// agrupados en un bloque destacado.
import IncludesRow, { type Item } from "./IncludesRow.astro";

const items: Item[] = [
  {
    title: "Formación práctica",
    detail: "12 horas · 4 sábados · 9:00 AM – 12:00 PM",
    icon: "calendar",
  },
  {
    title: "Certificado",
    detail:
      "Certificado virtual — <i>Inteligencia Artificial Aplicada al Trabajo Profesional</i> · apto para LinkedIn",
    icon: "award",
  },
  {
    title: "Comunidad",
    detail: "Grupo privado de WhatsApp con acceso directo al instructor",
    icon: "users",
  },
  {
    title: "Recursos",
    detail: "Materiales y recursos de por vida",
    icon: "download",
  },
  {
    title: "Claude Pro",
    detail: "Acceso durante todo el programa (~$86.000 COP de valor)",
    icon: "key-round",
    featured: true,
    eyebrow: "incluido sin costo",
  },
  {
    title: "Proyecto final",
    detail: "Personalizado a la profesión del estudiante",
    icon: "wrench",
    featured: true,
    eyebrow: "el diferenciador",
  },
];

const baseItems = items.filter((item) => !item.featured);
const featuredItems = items.filter((item) => item.featured);
---

<section
  data-screen-label="06 Qué incluye"
  style="padding: clamp(56px, 9vw, 104px) 0; background: var(--bg-1); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);"
>
  <div
    style="max-width: 1080px; margin: 0 auto; padding: 0 20px; display: flex; flex-direction: column; gap: clamp(28px, 4vw, 44px);"
  >
    <h2
      style="font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 4.6vw, 40px); line-height: 1.15; letter-spacing: -0.02em; margin: 0;"
    >
      Qué incluye
    </h2>
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div class="includes-list">
        {baseItems.map((item) => <IncludesRow {...item} />)}
      </div>
      <div class="includes-highlight">
        {featuredItems.map((item) => <IncludesRow {...item} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .includes-list {
    display: flex;
    flex-direction: column;
    max-width: 780px;
    border-top: 1px solid var(--border-default);
  }
  .includes-highlight {
    max-width: 780px;
    background: var(--bg-2);
    border-left: 3px solid var(--accent-ink);
    border-radius: var(--radius-xs) var(--radius-md) var(--radius-md) var(--radius-xs);
    padding: clamp(4px, 1.5vw, 10px) clamp(18px, 3vw, 26px);
  }
  .includes-highlight :global(.includes-row) {
    border-bottom: none;
  }
  .includes-highlight :global(.includes-row + .includes-row) {
    border-top: 1px solid var(--border-default);
  }
</style>
