---
// Fila de la sección 06 — ícono + título (+ eyebrow) + detalle.
// Los ítems `featured` conservan la misma métrica de la lista: solo cambian
// el color del ícono y de la tipografía.
// Íconos Lucide (stroke 1.75px, 22px, currentColor).

export interface Item {
  title: string;
  detail: string;
  icon: string; // Lucide icon name
  featured?: boolean;
  eyebrow?: string;
}

const { title, detail, icon, featured, eyebrow } = Astro.props as Item;

const icons: Record<string, string> = {
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M8 2v4M16 2v4M3 10h18"></path>',
  "key-round":
    '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>',
  award:
    '<circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5M12 15V3"></path>',
};
---

<div class="includes-row">
  <svg
    viewBox="0 0 24 24"
    width="22"
    height="22"
    fill="none"
    stroke={featured ? "var(--accent-ink)" : "var(--fg-3)"}
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    style="display: block; margin-top: 2px;"
    set:html={icons[icon]}
  />
  <div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 24px;">
    <div
      style="flex: 0 0 auto; width: 190px; max-width: 100%; display: flex; flex-direction: column; gap: 2px;"
    >
      <p class:list={["includes-title", featured && "featured-title"]}>{title}</p>
      {eyebrow && <span class="eyebrow" style="font-size: 10.5px;">{eyebrow}</span>}
    </div>
    <p class:list={["includes-detail", featured && "featured-detail"]} set:html={detail} />
  </div>
</div>

<style>
  .includes-row {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 6px 18px;
    align-items: start;
    padding: 20px 0;
    border-bottom: 1px solid var(--border-default);
  }
  .includes-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(17px, 2.2vw, 19px);
    color: var(--fg-1);
    letter-spacing: -0.01em;
  }
  .includes-title.featured-title {
    color: var(--accent-ink);
  }
  .includes-detail {
    margin: 0;
    flex: 1 1 220px;
    min-width: 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .includes-detail.featured-detail {
    color: var(--fg-1);
  }
</style>
