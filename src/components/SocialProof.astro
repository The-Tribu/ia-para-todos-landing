---
// Sección 02 — Prueba social
// Franja delgada horizontal debajo del hero. Solo la cifra.
---

<section
  data-screen-label="02 Prueba social"
  style="border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); background: var(--bg-1);"
>
  <div
    style="max-width: 1080px; margin: 0 auto; padding: 18px 20px; display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap;"
  >
    <p
      style="margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(17px, 2.6vw, 22px); color: var(--fg-1); letter-spacing: -0.01em;"
    >
      +23 profesionales ya se graduaron
    </p>
  </div>
</section>
