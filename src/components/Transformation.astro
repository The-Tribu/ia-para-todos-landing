---
// Sección 04 — Transformación (casos reales)
// Grid de 3 tarjetas con antes/después medibles.
// Avatares reales (nunca ilustraciones ni iniciales).
// Fotos en public/avatars/ — se sirven tal cual, sin procesamiento.

const cases = [
  {
    id: "felipe",
    headline: "Sistema MRP construido en <accent>3 horas</accent> — eliminó el trabajo manual que le tomaba toda la mañana",
    name: "Felipe Gómez",
    role: "Gerente General, Folcol",
    avatar: "/avatars/felipe-gomez.webp",
    extra: null,
  },
  {
    id: "saray",
    headline: "Reporte de conciliación de cartera: de un día completo a <accent>2 minutos</accent>",
    name: "Saray Foronda",
    role: "Asistente de facturación",
    avatar: "/avatars/saray-foronda.webp",
    extra: null,
  },
  {
    id: "vanessa",
    headline: "Sistema de retención en la fuente que detectó <accent>2 errores reales</accent> que llevaban tiempo pasando",
    name: "Vanessa Colorado",
    role: "Contadora pública",
    avatar: null,
    extra: "empezó el curso diciendo \"no tengo ni idea de cómo funciona\"",
  },
];
---

<section
  data-screen-label="04 Transformación"
  style="padding: clamp(56px, 9vw, 104px) 0; background: var(--bg-1); border-top: 1px solid var(--border-subtle);"
>
  <div
    style="max-width: 1080px; margin: 0 auto; padding: 0 20px; display: flex; flex-direction: column; gap: clamp(28px, 4vw, 44px);"
  >
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <span class="eyebrow">Lo que salió de las cohortes</span>
      <h2
        style="font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 4.6vw, 40px); line-height: 1.15; letter-spacing: -0.02em; margin: 0;"
      >
        Gente con tu mismo cargo, con un resultado medible.
      </h2>
    </div>
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;"
    >
      {
        cases.map((c) => (
          <div class="case-card">
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <p
                class="case-headline"
                set:html={c.headline.replace(/<accent>(.*?)<\/accent>/g, '<span style="color: var(--accent-ink);">$1</span>')}
              />
              {c.extra && (
                <p style="margin: 0; font-size: 13.5px; font-style: italic; line-height: 1.5; color: var(--fg-3);">
                  {c.extra}
                </p>
              )}
            </div>
            <div style="display: flex; align-items: center; gap: 12px; padding-top: 12px; border-top: 1px solid var(--border-subtle);">
              <div class="avatar-slot">
                {c.avatar ? (
                  <img src={c.avatar} alt={c.name} width="144" height="144" loading="lazy" />
                ) : (
                  /* TODO: reemplazar por la foto real cuando la tengamos */
                  <span>{c.name.split(" ").map((n) => n[0]).join("")}</span>
                )}
              </div>
              <div style="display: flex; flex-direction: column; gap: 1px;">
                <p style="margin: 0; font-size: 14px; font-weight: 600; color: var(--fg-2);">
                  {c.name}
                </p>
                <p style="margin: 0; font-size: 13px; color: var(--fg-3);">{c.role}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .case-card {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 14px;
    padding: 26px;
    background: var(--bg-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .case-headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--fg-1);
  }
  .avatar-slot {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--border-default);
    background: var(--bg-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--fg-3);
    font-size: 20px;
  }
  .avatar-slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
